t;verticalAlign=top;spacingLeft=10;spacingTop=4;fillColor=#F8FAFC;strokeColor=#CBD5E1;fontSize=11;fontColor=#334155;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="20" y="2710" width="1040" height="110" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>
